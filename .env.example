# AWS Credentials for Amazon Bedrock
# Configure these credentials to use Amazon Bedrock with Claude Sonnet 4
# See: https://docs.aws.amazon.com/bedrock/latest/userguide/security-iam.html

AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-west-2

# Optional: AWS session token (if using temporary credentials)
# AWS_SESSION_TOKEN=your_session_token_here

# Optional: Bedrock API key (alternative authentication method)
# AWS_BEARER_TOKEN_BEDROCK=your_bearer_token_here
